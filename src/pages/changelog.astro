---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

type ChangeType = "Added" | "Improved" | "Fixed";

interface Release {
    version: string;
    date: string;
    tag?: string;
    changes: { type: ChangeType; items: string[] }[];
}

const releases: Release[] = [
    {
        version: "v1.0.0",
        date: "May 15, 2026",
        tag: "Public Beta",
        changes: [
            {
                type: "Added",
                items: [
                    "Public Beta release of the unified DevSecOps platform.",
                    "Global dashboard with an aggregated risk score across all targets.",
                    "PDF & JSON report export for individual scans and projects.",
                    "GitLab CI integration alongside the existing GitHub Actions support.",
                ],
            },
            {
                type: "Improved",
                items: [
                    "Upgraded the Nuclei engine to v3.2 — now running 5000+ templates per scan.",
                    "Faster container layer scanning for large Docker images.",
                ],
            },
            {
                type: "Fixed",
                items: [
                    "Reduced false positives on the missing-security-headers check.",
                    "Dashboard pagination on accounts with long scan histories.",
                ],
            },
        ],
    },
    {
        version: "v0.9.0",
        date: "April 22, 2026",
        tag: "CI/CD & Reporting",
        changes: [
            {
                type: "Added",
                items: [
                    "GitHub Actions integration with build gating on critical findings.",
                    "Scheduled scans with automated email report delivery to stakeholders.",
                    "SAST coverage for JavaScript, TypeScript, and Python codebases.",
                ],
            },
            {
                type: "Improved",
                items: [
                    "Reduced average scan time by roughly 30%.",
                    "Clearer severity labeling across the findings table.",
                ],
            },
            {
                type: "Fixed",
                items: [
                    "Webhook retries now back off correctly on transient network errors.",
                    "Timezone handling for scheduled scans.",
                ],
            },
        ],
    },
    {
        version: "v0.8.0",
        date: "March 10, 2026",
        tag: "Container Scanning",
        changes: [
            {
                type: "Added",
                items: [
                    "Container image scanning for Docker and Kubernetes workloads.",
                    "REST API with API key authentication.",
                    "Multi-target scanning — web apps, Git repositories, and images in one run.",
                ],
            },
            {
                type: "Improved",
                items: [
                    "Dashboard initial load performance.",
                    "Dockerfile auto-detection inside monorepos.",
                ],
            },
            {
                type: "Fixed",
                items: [
                    "Crash when scanning an image referenced without an explicit tag.",
                    "Occasional duplicate entries in the recent activity feed.",
                ],
            },
        ],
    },
];

const typeStyles: Record<ChangeType, string> = {
    Added: "bg-green-500/10 text-green-400 border-green-500/20",
    Improved: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
    Fixed: "bg-rose-500/10 text-rose-400 border-rose-500/20",
};

const dotStyles: Record<ChangeType, string> = {
    Added: "bg-green-500",
    Improved: "bg-cyan-500",
    Fixed: "bg-rose-500",
};
---

<Layout title="Stratum - Changelog">
    <Navbar />
    <main class="pt-20">
        <section class="py-24 relative overflow-hidden">
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-cyan-500/5 rounded-full blur-[120px] -z-10"
            >
            </div>

            <div class="max-w-3xl mx-auto px-6">
                <!-- Header -->
                <div class="mb-16">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-500/5 text-cyan-400 text-xs font-medium mb-6"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"
                            ></span>
                        </span>
                        v1.0 Public Beta
                    </div>
                    <h1
                        class="text-4xl md:text-5xl font-bold font-heading text-white mb-4"
                    >
                        Changelog
                    </h1>
                    <p class="text-slate-400 text-lg max-w-xl">
                        Every notable change to Stratum, newest first. We ship
                        in public — follow along as the platform evolves.
                    </p>
                </div>

                <!-- Timeline -->
                <div class="space-y-12">
                    {
                        releases.map((release) => (
                            <div class="relative md:grid md:grid-cols-[140px_1fr] md:gap-8">
                                {/* Version / date rail */}
                                <div class="mb-4 md:mb-0 md:text-right md:pt-1">
                                    <div class="text-xl font-bold text-white font-mono">
                                        {release.version}
                                    </div>
                                    <div class="text-xs text-slate-500 mt-1">
                                        {release.date}
                                    </div>
                                    {release.tag && (
                                        <span class="inline-block mt-2 px-2 py-0.5 rounded-md bg-slate-800/80 border border-white/10 text-[10px] font-medium text-slate-400 uppercase tracking-wider">
                                            {release.tag}
                                        </span>
                                    )}
                                </div>

                                {/* Change card */}
                                <div class="bg-slate-900/50 border border-white/10 rounded-2xl p-6 md:p-8 hover:border-white/20 transition-colors">
                                    <div class="space-y-6">
                                        {release.changes.map((group) => (
                                            <div>
                                                <span
                                                    class={`inline-block px-2.5 py-0.5 rounded-md border text-xs font-bold mb-3 ${typeStyles[group.type]}`}
                                                >
                                                    {group.type}
                                                </span>
                                                <ul class="space-y-2">
                                                    {group.items.map((item) => (
                                                        <li class="flex items-start gap-3 text-sm text-slate-300 leading-relaxed">
                                                            <span
                                                                class={`mt-1.5 h-1.5 w-1.5 rounded-full shrink-0 ${dotStyles[group.type]}`}
                                                            />
                                                            <span>{item}</span>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Footer note -->
                <div
                    class="mt-16 pt-8 border-t border-white/10 text-center text-sm text-slate-500"
                >
                    Have feedback or spotted a bug?{" "}
                    <a
                        href="mailto:contact@stratum-app.com"
                        class="text-cyan-400 hover:text-cyan-300 transition-colors"
                        >Let us know</a
                    > — we read everything.
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
